# Required
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Persistent data (Coolify: mount volume at /data; local: ./data)
ADLEY_DATA_DIR=./data

# Logging (stdout — visible in Coolify container logs)
LOG_LEVEL=INFO

# Storage (only "json" today; Postgres planned via DATABASE_URL)
STORAGE_BACKEND=json

# Optional tuning
# DEEPSEEK_TIMEOUT_SECONDS=90
# MAX_HISTORY_MESSAGES=20

# --- Future self-hosted services (Coolify internal hostnames) ---
# DATABASE_URL=postgresql://adley:password@postgres:5432/adley
# REDIS_URL=redis://redis:6379/0
